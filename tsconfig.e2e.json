{
  "extends": "./tsconfig.base.json",
  "include": [
    "e2e/**/*.ts",
    "e2e/**/*.mjs",
    "playwright.config.ts",
    "src/renderer/global.d.ts",
    "src/preload/index.ts",
    "src/shared/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  }
}
