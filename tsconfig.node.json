{
  "extends": "./tsconfig.base.json",
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  }
}
